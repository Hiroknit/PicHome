<Window x:Class="AutoArrangePhotoFolder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PicHome"
        mc:Ignorable="d"
        Title="PicHome - 写真整理" 
        Height="840" Width="1300"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown"
        Background="#F5F5F5"
        Foreground="#333333"
        FontFamily="Segoe UI"
        FontSize="14">
    <DockPanel LastChildFill="True">
        <!-- Modern Menu Bar --><!--
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Menu Style="{StaticResource ModernMenuStyle}" Height="45" Padding="0,6">
                <MenuItem Header="終了 (F2)" Name="CloseMenuItem" Click="CloseMenuItem_Click" Style="{StaticResource ModernMenuItemStyle}"/>
                <MenuItem Header="キャンセル (ESC)" Name="CancelMenuItem" Click="CancelMenuItem_Click" Style="{StaticResource ModernMenuItemStyle}"/>
                <MenuItem Header="実行 (F12)" Name="ExecuteMenuItem" Click="ExecuteMenuItem_Click" Style="{StaticResource ModernMenuItemStyle}"/>
            </Menu>
        </Border>-->

        <!-- Main Content Area -->
        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Disabled">
            <Grid Margin="20,20,20,20" Background="Transparent">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title Section with Description -->
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="📸 PicHome" FontSize="28" FontWeight="Bold" Foreground="#0078D4" Margin="0,0,0,10"/>
                            <TextBlock Text="日付別フォルダで写真を整理します" FontSize="13" Foreground="#666666"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,10,0,10">
                            <Button x:Name="btnCancel" Content="キャンセル(ESC)" Width="120" Height="45" Style="{StaticResource ModernButtonStyle}" Click="btnCancel_Click" FontSize="12"/>
                            <Button x:Name="btnExecute" Content="実行(F12)" Width="120" Height="45" Style="{StaticResource ModernButtonStyle}" Click="btnExecute_Click" FontSize="12" Margin="20,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="2" Background="#E0E0E0" Margin="0,0,0,20"/>
                </StackPanel>

                <!-- Progress Bar Section + Controls on Left -->
                <Grid Grid.Row="1" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="350"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Controls on Left: Folders + Settings -->
                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <!-- Source Folder Section -->
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="📁 処理対象フォルダ" FontSize="13" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,10"/>
                            <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="#E0E0E0" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBox Grid.Row="0" Name="txtSourcePath" Style="{StaticResource ModernTextBoxStyle}" Height="36" VerticalAlignment="Center" FontSize="12" Padding="12,8" Margin="0,0,0,8"/>
                                    <Button Grid.Row="1" Name="btnBrowse1" Content="参照" Height="36" Style="{StaticResource ModernButtonStyle}" Click="btnBrowse1_Click" FontSize="12"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Destination Folder Section -->
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="📂 コピー先フォルダ (JPG)" FontSize="13" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,10"/>
                            <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="#E0E0E0" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox Grid.Row="0" Name="cbJpgEnabled" Content="コピーする" 
                                              Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" FontSize="12" Margin="0,0,0,8" Checked="cbJpgEnabled_Checked" Unchecked="cbJpgEnabled_Unchecked"/>
                                    <TextBox Grid.Row="1" Name="txtDestJpgPath" Style="{StaticResource ModernTextBoxStyle}" Height="36" VerticalAlignment="Center" FontSize="12" Padding="12,8" Margin="0,0,0,8"/>
                                    <Button Grid.Row="2" Name="btnBrowseJpg" Content="参照" Height="36" Style="{StaticResource ModernButtonStyle}" Click="btnBrowseJpg_Click" FontSize="12"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Destination Folder Section for RAW -->
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="📂 コピー先フォルダ (RAW)" FontSize="13" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,10"/>
                            <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="#E0E0E0" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox Grid.Row="0" Name="cbRawEnabled" Content="コピーする" 
                                              Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" FontSize="12" Margin="0,0,0,8" Checked="cbRawEnabled_Checked" Unchecked="cbRawEnabled_Unchecked"/>
                                    <TextBox Grid.Row="1" Name="txtDestRawPath" Style="{StaticResource ModernTextBoxStyle}" Height="36" VerticalAlignment="Center" FontSize="12" Padding="12,8" Margin="0,0,0,8"/>
                                    <Button Grid.Row="2" Name="btnBrowseRaw" Content="参照" Height="36" Style="{StaticResource ModernButtonStyle}" Click="btnBrowseRaw_Click" FontSize="12"/>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Date/Time Filter Section -->
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="🕐  日付フィルター" FontSize="13" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,10"/>
                            <Border Background="White" CornerRadius="6" Padding="12" BorderBrush="#E0E0E0" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox Grid.Row="0" Name="cbDateFilterEnabled" Content="指定日以降のみコピー" 
                                              Style="{StaticResource ModernCheckBoxStyle}" VerticalAlignment="Center" FontSize="12" Margin="0,0,0,12" Checked="cbDateFilterEnabled_Checked" Unchecked="cbDateFilterEnabled_Unchecked"/>
                                    <TextBlock Grid.Row="1" Text="日付:" FontSize="12" Foreground="#666666" Margin="0,0,0,4"/>
                                    <DatePicker Grid.Row="1" Name="dpFilterDate" Height="36" SelectedDateFormat="Short" FontSize="14" Margin="0,16,0,8" VerticalAlignment="Center" VerticalContentAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Progress Bar and Log Output on Right -->
                    <Grid Grid.Column="1">
                        <StackPanel Margin="0,0,0,0">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Column="0" Grid.Row="0" Text="📊 進行状況" FontSize="14" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Grid.Row="0" Name="ProgressLabel" Text="0%" FontSize="12" Foreground="#0078D4" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </Grid>
                            <ProgressBar Name="ProgressBar" Style="{StaticResource ModernProgressBarStyle}" Height="10" Background="#E8E8E8" Margin="0,0,0,18" Maximum="100"/>

                            <!-- Log Output Section -->
                            <TextBlock Text="📝 実行ログ" FontSize="14" FontWeight="SemiBold" Foreground="#333333" Margin="0,0,0,12"/>
                            <Border Background="White" CornerRadius="6" BorderBrush="#E0E0E0" BorderThickness="1" Padding="0">
                                <RichTextBox Name="richtxtMessage" IsReadOnly="True" Style="{StaticResource ModernRichTextBoxStyle}" Padding="16" Height="565" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
